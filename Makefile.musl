ARCH ?= $(shell uname -m)
OUT ?= kd-$(ARCH)
CFLAGS ?= -O2 -Wall -Wextra
LDFLAGS ?= -static

PREFIX ?= /usr
BINDIR ?= $(PREFIX)/bin
MANDIR ?= $(PREFIX)/share/man/man1

CC := $(shell \
	if [ "$(ARCH)" = "`uname -m`" ] && command -v musl-gcc >/dev/null 2>&1; then \
		echo musl-gcc; \
	elif command -v $(ARCH)-linux-musl-gcc >/dev/null 2>&1; then \
		echo $(ARCH)-linux-musl-gcc; \
	elif command -v clang >/dev/null 2>&1 && [ -d /usr/$(ARCH)-linux-musl ]; then \
		echo "clang --target=$(ARCH)-linux-musl --sysroot=/usr/$(ARCH)-linux-musl"; \
	elif command -v zig >/dev/null 2>&1; then \
		echo "zig cc -target $(ARCH)-linux-musl"; \
	fi)

$(OUT): kd.c kf.h
	@test -n "$(CC)" || { \
		echo "Makefile.musl: ingen musl-toolchain for $(ARCH)" >&2; \
		echo "  installera $(ARCH)-linux-musl-gcc, eller zig" >&2; \
		exit 1; }
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ kd.c

install: $(OUT)
	install -Dm755 $(OUT) $(DESTDIR)$(BINDIR)/kd
	install -Dm644 kd.1 $(DESTDIR)$(MANDIR)/kd.1

uninstall:
	rm -f $(DESTDIR)$(BINDIR)/kd $(DESTDIR)$(MANDIR)/kd.1

clean:
	rm -f $(OUT)

.PHONY: install uninstall clean
